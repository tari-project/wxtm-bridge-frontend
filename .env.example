NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=''
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
# Set to 'true' only for builds loaded by a Tari Universe dev build (pnpm tauri dev), so its
# http://localhost:1420 origin may frame the tapplet. Never set it for release builds.
NEXT_PUBLIC_ALLOW_UNIVERSE_DEV_ORIGIN=false
# Tari network for the dev server (next dev), which has no Universe to ask, e.g. 'esmeralda' or 'mainnet'.
# Empty: not mainnet, no Ootle routes. Ignored by builds, which ask Universe.
NEXT_PUBLIC_TARI_NETWORK=
